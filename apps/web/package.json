{
  "name": "@perchados/web",
  "version": "0.0.0",
  "private": true,
  "description": "Panel de administración de Perchados (Next.js App Router)",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@perchados/api-client": "workspace:*",
    "@perchados/contracts": "workspace:*",
    "@perchados/ui-tokens": "workspace:*",
    "@perchados/ui-web": "workspace:*",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@node-rs/argon2": "2.2.1",
    "@perchados/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "pg": "8.23.0",
    "stylelint": "17.15.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "vitest-axe": "0.1.0"
  }
