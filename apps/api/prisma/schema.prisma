generator client {
  provider     = "prisma-client"
  output       = "../src/shared/database/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  DISABLED

  @@map("account_status")
}

model Role {
  id        String    @id @default(uuid(7)) @db.Uuid
  code      String    @unique @db.VarChar(32)
  name      String    @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  accounts  Account[]

  @@map("role")
}

model Account {
  id             String        @id @default(uuid(7)) @db.Uuid
  username       String        @db.VarChar(64)
  usernameKey    String        @unique @map("username_key") @db.VarChar(64)
  roleId         String        @map("role_id") @db.Uuid
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status         AccountStatus @default(ACTIVE)
  passwordHash   String        @map("password_hash")
  failedAttempts Int           @default(0) @map("failed_attempts")
  lockedUntil    DateTime?     @map("locked_until") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions       Session[]

  @@index([roleId])
  @@map("account")
}

model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  accountId     String    @map("account_id") @db.Uuid
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([accountId])
  @@index([expiresAt])
  @@map("session")
}

model LoginAttemptUnknown {
  usernameKey    String    @id @map("username_key") @db.VarChar(64)
  failedAttempts Int       @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("login_attempt_unknown")
}

model RateLimitCounter {
  key       String   @id @db.VarChar(255)
  hits      Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_counter")
}
