{
  "name": "@perchados/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST de Perchados (NestJS hexagonal, rutas bajo /v1)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "bench:hash": "nest build && node scripts/bench-hash.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@perchados/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "helmet": "8.3.0",
    "nestjs-pino": "5.2.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@perchados/config": "workspace:*",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  }
}
