{
  "name": "perchados",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "db:migrate": "turbo run db:migrate",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:seed": "turbo run db:seed",
    "contract:generate": "turbo run contract:generate",
    "contract:check": "turbo run contract:check",
    "test:e2e": "turbo run test:e2e",
    "test:scripts": "node --test \"scripts/ci/*.test.mjs\"",
    "ci:migrations": "node scripts/ci/check-migrations-immutable.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@perchados/config": "workspace:*",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "mysql2": "3.22.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
