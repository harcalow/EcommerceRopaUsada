{
  "name": "@perchados/ui-web",
  "version": "0.0.0",
  "private": true,
  "description": "Componentes React accesibles del design system web (ADR-009); se publican como fuente TS y Next.js los transpila",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./focus.css": "./src/styles/focus.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@perchados/config": "workspace:*",
    "@perchados/ui-tokens": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylelint": "17.15.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "vitest-axe": "0.1.0"
  },
  "dependencies": {
    "lucide-react": "1.49.0"
  }
}
