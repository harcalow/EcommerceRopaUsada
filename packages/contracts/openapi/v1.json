{
  "openapi": "3.0.3",
  "info": {
    "title": "Perchados API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "ProblemFieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message",
          "code"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "validation-error",
              "malformed-request",
              "auth/invalid-credentials",
              "auth/unauthenticated",
              "auth/session-expired",
              "auth/forbidden",
              "auth/csrf-invalid",
              "not-found",
              "payload-too-large",
              "auth/account-locked",
              "rate-limit-exceeded",
              "internal-error",
              "health/unavailable"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "minLength": 1
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message",
                "code"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "correlationId"
        ],
        "additionalProperties": false
      },
      "HealthOk": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "up"
                ]
              }
            },
            "required": [
              "database"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      },
      "HealthUnavailable": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "health/unavailable"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "number",
            "enum": [
              503
            ]
          },
          "detail": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "minLength": 1
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message",
                "code"
              ],
              "additionalProperties": false
            }
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "down"
                ]
              }
            },
            "required": [
              "database"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "correlationId",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Estado de la API y de la base de datos",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "API y base de datos disponibles",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "description": "Identificador de correlación"
                },
                "required": true,
                "description": "Identificador de correlación"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOk"
                }
              }
            }
          },
          "503": {
            "description": "La base de datos no responde",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "description": "Identificador de correlación"
                },
                "required": true,
                "description": "Identificador de correlación"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailable"
                }
              }
            }
          }
        }
      }
    }
  }
}
