# Copia este archivo a un archivo de entorno local y ajusta los valores.
# El archivo de entorno nunca se versiona. Los valores de ejemplo NO son secretos reales.

# --- Postgres (docker compose: servicio postgres) ---
POSTGRES_USER=perchados
POSTGRES_PASSWORD=perchados_dev_password
POSTGRES_DB=perchados
# Puerto publicado en tu máquina
POSTGRES_PORT=5432

# --- Almacenamiento compatible con S3 (servicio storage) ---
# Puertos de la API S3 y de la consola web, publicados en tu máquina
STORAGE_API_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Credenciales de ejemplo para desarrollo
STORAGE_ACCESS_KEY=perchados_dev_access
STORAGE_SECRET_KEY=perchados_dev_secret_key
STORAGE_BUCKET=perchados-garments

# --- Mailpit: captura de emails de desarrollo ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Aplicaciones (perfil apps de docker compose) ---
# Puertos publicados de la API y de la web
API_PORT=3001
WEB_PORT=3000

# --- Entorno de ejecución (API y web) ---
# development | test | ci | production
APP_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Base de datos de la aplicación (spec 001) ---
# Debe cuadrar con las variables de Postgres de arriba
DATABASE_URL=postgresql://perchados:perchados_dev_password@localhost:5432/perchados
# Opcional: base de las pruebas de integración. Debe terminar en _test.
# Si no se define, se usa DATABASE_URL con el nombre terminado en _test (perchados_test).
# TEST_DATABASE_URL=postgresql://perchados:perchados_dev_password@localhost:5432/perchados_test

# --- Administrador (spec 001) ---
# La define el dueño de la tienda; nunca se versiona ni se escribe aquí.
# Solo la lee el seed (db:seed) para crear la cuenta inicial.
ADMIN_INITIAL_PASSWORD=
# Correo del responsable, para pedir ayuda si se pierde el acceso (RF-007 de la 001).
# La web lo exige con formato de correo válido; este valor es solo de desarrollo.
ADMIN_CONTACT_EMAIL=admin@perchados.local

# --- Sesión ---
# Duración de la sesión del administrador, en horas
SESSION_TTL_HOURS=8
# Dominio de la cookie de sesión. Obligatorio si APP_ENV=production; en desarrollo se deja vacío.
SESSION_COOKIE_DOMAIN=

# --- Seguridad HTTP de la API ---
# Orígenes web permitidos por CORS, separados por comas (la web en desarrollo)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Proxy de confianza: false, número de saltos o lista de IP/CIDR
TRUST_PROXY=false
# Tamaño máximo del cuerpo de las peticiones, en KB
BODY_LIMIT_KB=100
# Límites de peticiones por minuto y por IP: global y en rutas de autenticación
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=10

# --- Hash de contraseñas (Argon2id) ---
# Memoria en KiB, iteraciones y paralelismo. Con 10 iteraciones el mínimo OWASP es 7168 KiB.
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=10
PASSWORD_HASH_PARALLELISM=1

# --- Salud ---
# Tiempo máximo para consultar la base en /v1/health, en ms (máximo 2500)
HEALTH_DB_TIMEOUT_MS=2000

# --- Conexión de la web con la API ---
# URL con la que el servidor de la web llega a la API (dentro de Docker: http://api:3001)
API_INTERNAL_URL=http://localhost:3001
# URL pública de la API, la que ve el navegador (se añade a connect-src de la CSP)
API_PUBLIC_URL=http://localhost:3001

# --- IP del cliente entre la web y la API (RT-022, ADR-011) ---
# Secreto compartido: la web lo envía a la API (X-Perchados-Internal-Token) para que esta acepte la IP del cliente.
# Obligatorio, mínimo 32 caracteres y el MISMO valor en api y web. Sin valor por defecto: generar con
#   openssl rand -base64 32
# Nunca se versiona el valor real; docker compose se niega a arrancar api y web si falta.
INTERNAL_API_SECRET=
# Saltos de confianza delante de la web: cuántas entradas, contadas desde la derecha de X-Forwarded-For,
# escribió el proxy de borde. 0 = no hay IP del cliente (válido en local/Docker/CI); en production debe ser >= 1.
# TRUST_PROXY (más arriba) describe solo el proxy delante de la API; en production no puede ser false.
WEB_TRUST_PROXY_HOPS=0
